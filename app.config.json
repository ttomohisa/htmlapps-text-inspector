{
  "name": "Text Inspector",
  "slug": "htmlapps-text-inspector",
  "version": "1.0.2",
  "defaultLanguage": "ja",
  "release": {
    "readable": "dist/index.html",
    "selfExtract": "dist/index.self-extract.html"
  },
  "budgets": {
    "readableWarnBytes": 120000,
    "selfExtractWarnBytes": 50000
  },
  "build": {
    "output": "dist/index.html",
    "selfExtract": {
      "output": "dist/index.self-extract.html"
    },
    "blockRuntimeNetwork": true
  }
}
